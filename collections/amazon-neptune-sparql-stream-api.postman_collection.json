      "item": [
        {
          "id": "336f28f4-9ad7-48d4-ad0a-29f2f719d9e7",
          "name": "Amazon Neptune Get SPARQL RDF Change Stream Records",
          "request": {
            "name": "Amazon Neptune Get SPARQL RDF Change Stream Records",
            "description": {
              "content": "Gets a stream of change-log entries for RDF (SPARQL) data. Each entry records a mutation (ADD or REMOVE) of an RDF triple or quad. The response format is NQUADS, with each change represented as an N-Quads statement string.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sparql",
                "stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of records to return (1-100,000). Default is 10."
                },
                {
                  "disabled": false,
                  "key": "iteratorType",
                  "value": "AT_SEQUENCE_NUMBER",
                  "description": "Determines the starting point for reading the stream."
                },
                {
                  "disabled": false,
                  "key": "commitNum",
                  "value": "<integer>",
                  "description": "The commit number to start reading from. Required when iteratorType is AT_SEQUENCE_NUMBER or AFTER_SEQUENCE_NUMBER."
                },
                {
                  "disabled": false,
                  "key": "opNum",
                  "value": "1",
                  "description": "The operation sequence number within the specified commit."
                }
              ],
              "variable": [
                {
                  "description": "AWS region",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Set to 'gzip' to receive compressed responses.",
                "key": "Accept-Encoding",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
